{
    "framework": "vite",
    "crons": [
        { "path": "/api/contract-alerts/run", "schedule": "0 12 * * *" }
    ],
    "rewrites": [
        { "source": "/api/agency/(.*)", "destination": "/api/agency" },
        { "source": "/api/auth/login", "destination": "/api/master?route=auth-login" },
        { "source": "/api/admin/provision", "destination": "/api/master?route=admin-provision" },
        { "source": "/api/email/send", "destination": "/api/master?route=email-send" },
        { "source": "/api/billing/(.*)", "destination": "/api/billing" },
        { "source": "/api/contracts/public", "destination": "/api/contracts?action=public" },
        { "source": "/api/contracts/public-sign", "destination": "/api/contracts?action=public-sign" },
        { "source": "/api/contracts/templates", "destination": "/api/contracts?action=templates" },
        { "source": "/api/contracts/events", "destination": "/api/contracts?action=events" },
        { "source": "/api/contracts/send-signature", "destination": "/api/contracts?action=send-signature" },
        { "source": "/api/contract-alerts/(.*)", "destination": "/api/contract-alerts" },
        { "source": "/api/inspections/images", "destination": "/api/inspections?action=images" },
        { "source": "/api/leads/(.*)", "destination": "/api/leads" },
        { "source": "/api/property-documents/generate", "destination": "/api/property-documents?action=generate" },
        { "source": "/api/property-documents/send-email", "destination": "/api/property-documents?action=send-email" },
        { "source": "/api/property-processes/:id/events", "destination": "/api/property-processes?id=:id&events=1" },
        { "source": "/api/property-processes/:id", "destination": "/api/property-processes?id=:id" },
        { "source": "/api/broadcast/push", "destination": "/api/push" },
        { "source": "/api/push/(.*)", "destination": "/api/push" },
        { "source": "/api/subscriptions/(.*)", "destination": "/api/subscriptions" },
        { "source": "/api/master/(.*)", "destination": "/api/master" },
        { "source": "/api/upload/serve", "destination": "/api/upload" },
        { "source": "/api/(.*)", "destination": "/api/$1" },
        { "source": "/(.*)", "destination": "/index.html" }
    ]
}
